# Postgres connection string. Local docker-compose default:
DATABASE_URL="postgresql://mohalla:mohalla@127.0.0.1:5432/mohalla"

# Random string, at least 16 characters. Used to sign login cookies.
# Example: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# City the app opens on. Any city name works; listings are filtered by the city
# stored on each venue. Coordinates centre the map before venues load.
NEXT_PUBLIC_DEFAULT_CITY="Vadodara"
NEXT_PUBLIC_DEFAULT_LAT="22.3072"
NEXT_PUBLIC_DEFAULT_LNG="73.1812"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Kolkata"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payments. Leave blank to keep the default: pay at the venue.
# When all three are set, players can pay online with Razorpay.
# RAZORPAY_KEY_SECRET stays on the server. The public key is safe in the browser.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Optional SMS provider for a future one-time-password flow.
# Phone login in this app uses the mobile number plus a password, so these
# keys are not required to run Mohalla.
# SMS_PROVIDER: console | msg91 | twilio
SMS_PROVIDER="console"
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Optional. Venue photos are image URLs by default.
# Set this to store uploads in Vercel Blob instead of pasting links.
BLOB_READ_WRITE_TOKEN=""
